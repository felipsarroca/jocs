// SPDX-License-Identifier: AGPL-3.0-or-later
// Maniobres: rànquing públic. Cada jugador només pot escriure el seu document,
// però pot continuar amb el seu nom des d'un altre dispositiu (el jugador s'hi trasllada).
// La validesa de les solucions la comprova qui llegeix el rànquing (reproducció amb el motor).
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function validName(d) {
      return d.name is string && d.name.size() >= 3 && d.name.size() <= 16
        && d.key is string && d.key.matches('^[a-z0-9]{3,16}$')
        && getAfter(/databases/$(db)/documents/names/$(d.key)).data.uid == request.auth.uid;
    }
    function fresh(d) {
      return d.keys().hasOnly(['name', 'key', 'since', 'at', 'last', 'r'])
        && d.since == request.time && d.at == request.time && d.last == '' && d.r == {};
    }
    // Continuar amb un nom des d'un altre dispositiu: el nom passa a aquest usuari i el
    // jugador s'hi trasllada tal com era (còpia exacta), o de nou si ja no existia.
    function claimed(d) {
      let before = get(/databases/$(db)/documents/names/$(d.key)).data.uid;
      let old = /databases/$(db)/documents/players/$(before);
      return before != request.auth.uid && validName(d)
        && (exists(old) ? d == get(old).data : fresh(d));
    }
    function validEntry(e) {
      return e.keys().hasOnly(['n', 'l', 't', 's']) && e.n is int
        && (!('s' in e) || (e.s is int && e.s >= 0 && e.s <= 86400)) && e.n >= 1 && e.n <= 60
        && e.l is string && e.l.size() == 2 * e.n && e.l.matches('^([1-3][0-3])+$')
        && e.t == request.time;
    }

    match /names/{key} {
      allow read: if true;
      allow create: if signedIn() && key.matches('^[a-z0-9]{3,16}$')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      // Continuar amb el nom: només si el jugador anterior desapareix en la mateixa operació.
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(db)/documents/players/$(request.auth.uid)).data.key == key
        && !existsAfter(/databases/$(db)/documents/players/$(resource.data.uid));
    }

    match /players/{uid} {
      allow read: if true;
      allow create: if signedIn() && uid == request.auth.uid
        && ((fresh(request.resource.data) && validName(request.resource.data))
          || claimed(request.resource.data));
      allow update: if signedIn() && uid == request.auth.uid && claimed(request.resource.data);
      allow update: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'key', 'since', 'at', 'last', 'r'])
        && request.resource.data.since == resource.data.since
        && validName(request.resource.data)
        && (
          // Canvi de nom, sense tocar resultats.
          (request.resource.data.r == resource.data.r && request.resource.data.at == resource.data.at
            && request.resource.data.last == resource.data.last)
          ||
          // Un resultat nou o millorat, com a molt un cada 5 segons; es poden treure resultats propis.
          (request.resource.data.name == resource.data.name
            && request.resource.data.at == request.time
            && (resource.data.last == '' || request.time > resource.data.at + duration.value(5, 's'))
            && request.resource.data.last.matches('^19[0-9]{6,12}$')
            && request.resource.data.r.diff(resource.data.r).addedKeys()
                 .union(request.resource.data.r.diff(resource.data.r).changedKeys())
                 .hasOnly([request.resource.data.last])
            && validEntry(request.resource.data.r[request.resource.data.last])
            && (!(request.resource.data.last in resource.data.r)
                || request.resource.data.r[request.resource.data.last].n < resource.data.r[request.resource.data.last].n
                || resource.data.r[request.resource.data.last].t < request.time - duration.value(365, 'd')))
        );
      allow delete: if signedIn() && (uid == request.auth.uid
        || getAfter(/databases/$(db)/documents/names/$(resource.data.key)).data.uid == request.auth.uid);
    }
  }
}
